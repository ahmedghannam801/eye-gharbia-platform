{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:headed": "dotenv -e .env.test -- playwright test --headed",
    "test:e2e:debug": "dotenv -e .env.test -- playwright test --debug",
    "test:e2e:mobile": "dotenv -e .env.test -- playwright test --project=mobile-chrome --project=mobile-safari --project=mobile-small",
    "test:e2e:desktop": "dotenv -e .env.test -- playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:regression": "dotenv -e .env.test -- playwright test --project=regression",
    "test:e2e:auth": "dotenv -e .env.test -- playwright test tests/auth/",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:e2e:chromium": "dotenv -e .env.test -- playwright test --project=chromium",
    "test:e2e:firefox": "dotenv -e .env.test -- playwright test --project=firefox"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.45.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.125.0"
  }
}
